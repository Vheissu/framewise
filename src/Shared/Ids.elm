module Shared.Ids exposing
    ( AssetId
    , DocumentId
    , KeyframeId
    , MotionPathId
    , NodeId
    , SceneId
    , TrackId
    , localId
    )

{-| Identifier aliases. Persistent identities are generated by the platform
bridge (crypto.randomUUID). `localId` builds deterministic derived ids for
objects created inside a single editor command from an already-random seed.
-}


type alias DocumentId =
    String


type alias SceneId =
    String


type alias NodeId =
    String


type alias TrackId =
    String


type alias KeyframeId =
    String


type alias AssetId =
    String


type alias MotionPathId =
    String


localId : String -> String -> Int -> String
localId prefix seed index =
    prefix ++ "_" ++ seed ++ "_" ++ String.fromInt index
