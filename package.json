{
  "name": "framewise",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first SVG and vector animation editor built with Elm.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint web tests",
    "format:check": "prettier --check \"web/**/*.{ts,css}\" \"tests/**/*.ts\" && elm-format --validate src tests",
    "format": "prettier --write \"web/**/*.{ts,css}\" \"tests/**/*.ts\" && elm-format --yes src tests",
    "elm:test": "elm-test tests/*.elm",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm run elm:test && pnpm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "elm": "0.19.3-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.3-0",
    "eslint": "9.39.5",
    "jsdom": "27.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vite-plugin-elm": "3.0.1",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "fflate": "0.8.2"
  }
}
